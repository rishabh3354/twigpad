#!/bin/sh
# Starts Twigpad from the AppImage with the Python and Qt bundled inside it.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"

# Only the bundled Python and Qt: nothing from the host's Python or Qt setup.
unset PYTHONHOME PYTHONPATH QT_PLUGIN_PATH QML2_IMPORT_PATH
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
# X11 window class "twigpad", as with the pip and snap installs (Qt would take
# it from argv[0], which is __main__.py here).
export RESOURCE_NAME="${RESOURCE_NAME:-twigpad}"

# The bundled OpenSSL looks for CA certificates in /etc/ssl; point it at the
# host's bundle wherever this distribution keeps it (for dictionary downloads).
if [ -z "$SSL_CERT_FILE" ]; then
    for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
             /etc/ssl/ca-bundle.pem /etc/ssl/cert.pem /etc/pki/tls/cacert.pem; do
        if [ -r "$f" ]; then export SSL_CERT_FILE="$f"; break; fi
    done
fi

exec "$HERE/usr/python/bin/python3" -s -m twigpad "$@"
